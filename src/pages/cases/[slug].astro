---
/**
 * Case study page — the full story behind one CaseStudies card. Opens on the
 * problem and the same facts the card shows, tells the story, and ends on the
 * page's one action. Story copy is lorem ipsum until the real cases land.
 */
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import Button from '~/components/ui/Button.astro';
import { Image } from 'astro:assets';
import { headerData, mapUrl } from '~/navigation';
import { cases, readMinutes, type Case } from '~/data/cases';

export function getStaticPaths() {
  return cases.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props as { c: Case };

const facts = [
  { term: 'Business', detail: c.name },
  { term: 'Industry and size', detail: c.business },
  { term: 'Value captured', detail: c.value, note: c.basis },
  { term: 'How long', detail: c.took },
];
---

<Layout metadata={{ title: `${c.name} case study: ${c.label}` }}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ variant: 'primary', text: 'See what to fix first', href: mapUrl }]}
      isSticky
    />
  </Fragment>

  <article
    class="mx-auto max-w-6xl px-4 md:px-6 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-[13rem_minmax(0,46rem)] lg:justify-center gap-10 lg:gap-16 items-start"
  >
    <!-- The facts are a margin note beside the story, not a second column of it:
         one left edge carries the whole argument, from back link to CTA. -->
    <dl
      class="order-2 lg:order-1 m-0 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-1 gap-x-6 gap-y-5 border-y border-default/10 py-6 lg:sticky lg:top-[120px] lg:border-y-0 lg:py-0"
    >
      {
        facts.map((f) => (
          <div class="relative">
            <dt class="font-mono text-sm uppercase tracking-label text-muted">{f.term}</dt>
            <dd class="m-0 mt-1 text-base font-semibold leading-snug text-default">
              {f.detail}
              {f.note && (
                <span class="tip ml-1 inline-flex align-middle">
                  <button
                    type="button"
                    class="tip-btn h-4 w-4 rounded-full border border-muted/50 font-mono text-[10px] font-normal leading-none text-muted hover:border-primary hover:text-primary"
                    aria-label={`Where the ${f.term.toLowerCase()} number comes from`}
                  >
                    i
                  </button>
                  <span role="tooltip" class="tip-box">
                    {f.note}
                  </span>
                </span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="order-1 lg:order-2">
      <a href="/#case-studies" class="font-mono text-sm uppercase tracking-label text-muted hover:text-primary">
        All case studies
      </a>

      <p class="mt-10 font-mono text-sm uppercase tracking-label text-secondary">
        Case study · {readMinutes(c)} min read
      </p>
      <h1 class="mt-3 font-heading text-4xl md:text-5xl font-bold tracking-heading text-default">{c.problem}</h1>

      <div class="mt-10">
        {
          c.image ? (
            <Image
              src={c.image}
              alt={c.imageAlt ?? ''}
              widths={[640, 960, 1440]}
              sizes="(min-width: 1024px) 720px, 100vw"
              class="aspect-[16/9] w-full rounded-2xl object-cover object-[50%_28%]"
              loading="eager"
            />
          ) : (
            <div
              class="aspect-[16/9] rounded-2xl bg-section flex items-center justify-center font-mono text-sm uppercase tracking-label text-muted"
              aria-hidden="true"
            >
              [Image]
            </div>
          )
        }
      </div>

      {
        c.story.map((chapter) => (
          <section class="mt-14">
            <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-heading text-default">{chapter.heading}</h2>
            {chapter.paragraphs.map((p) => (
              <p class="mt-5 font-display text-lg leading-relaxed text-default">{p}</p>
            ))}
            {chapter.quote && (
              <figure class="mt-8 border-l-2 border-accent pl-6">
                <blockquote class="font-display text-xl leading-relaxed text-default">{chapter.quote.text}</blockquote>
                <figcaption class="mt-3 font-mono text-sm uppercase tracking-label text-muted">
                  {chapter.quote.source}
                </figcaption>
              </figure>
            )}
          </section>
        ))
      }

      <div class="mt-20 border-t border-default/10 pt-12">
        <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-heading text-default">
          Find where your business is losing money.
        </h2>
        <p class="mt-3 text-lg leading-relaxed text-muted">The free map takes 8 minutes and shows what to fix first.</p>
        <div class="mt-8">
          <Button variant="primary" text="See what to fix first" href={mapUrl} />
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* Basis tooltip: CSS only, shown on hover and on keyboard focus. The text is
     in the DOM either way, so a screen reader and a printed page both keep it. */
  /* Anchored to the fact column, not to the icon, so it lines up under the term
     even when the term wraps to two lines. */
  .tip {
    position: static;
  }
  .tip-box {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    z-index: 20;
    width: max-content;
    max-width: 17rem;
    border-radius: 0.5rem;
    background: rgb(var(--aw-color-bg-prussian));
    color: rgb(var(--aw-color-text-cream));
    padding: 0.625rem 0.75rem;
    font-family: var(--aw-font-sans);
    font-size: 0.8125rem;
    line-height: 1.5;
    letter-spacing: normal;
    text-transform: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity 160ms ease,
      transform 160ms ease,
      visibility 160ms;
  }
  .tip-btn:hover + .tip-box,
  .tip-btn:focus-visible + .tip-box,
  .tip:hover .tip-box {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .tip-box {
      transition: none;
    }
  }
</style>
