---
import Layout from '~/layouts/PageLayout.astro';

import { getHomePermalink } from '~/utils/permalinks';
import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import HowItWorks from '~/components/widgets/HowItWorks.astro';
import Deliverable from '~/components/widgets/Deliverable.astro';
import CaseStudies from '~/components/widgets/CaseStudies.astro';
import HeroChalkMap from '~/components/widgets/HeroChalkMap.astro';
import FAQ from '~/components/widgets/FAQ.astro';
import FeaturedTestimonial from '~/components/widgets/FeaturedTestimonial.astro';
import RiskReversal from '~/components/widgets/RiskReversal.astro';
import FinalCTA from '~/components/widgets/FinalCTA.astro';
import ProblemAgitation from '~/components/widgets/ProblemAgitation.astro';
import Stats from '~/components/widgets/Stats.astro';
const metadata = {
  title: 'Rapid Insights Consulting | Data & Analytics for Growing Businesses',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      links={[{ text: 'Home', href: getHomePermalink() }]}
      actions={[
        {
          variant: 'primary',
          text: "Find out what you can't see",
          href: '/scorecard',
          'data-astro-prefetch': true,
        },
      ]}
      isSticky
    />
  </Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="You spend more time reacting than leading."
    tagline=""
    actions={[
      { variant: 'primary', text: "Find out what you can't see", href: '/scorecard', 'data-astro-prefetch': true },
    ]}
  >
    <Fragment slot="bg">
      <!-- Dot grid: graph-paper texture, 24px tile, 18% cream over Prussian base -->
      <div
        class="absolute inset-0"
        style="background-image: radial-gradient(circle at center, rgba(250, 245, 239, 0.18) 1px, transparent 1.25px); background-size: 24px 24px;"
        aria-hidden="true"
      >
      </div>

      <!-- Vignette (desktop): focal left-biased behind H1, dots fade on all edges.
           H1 zone stays fully bright; left/top/bottom edges fade gently; right side fully Prussian. -->
      <div
        class="absolute inset-0 hidden md:block"
        style="background: radial-gradient(ellipse 70% 80% at 35% 50%, rgb(1 28 66 / 0) 0%, rgb(1 28 66 / 0) 20%, rgb(1 28 66) 100%);"
        aria-hidden="true"
      >
      </div>

      <!-- Vignette (mobile): centered focal, dots fade on all four edges uniformly -->
      <div
        class="absolute inset-0 md:hidden"
        style="background: radial-gradient(ellipse 85% 85% at 50% 45%, rgb(1 28 66 / 0) 0%, rgb(1 28 66 / 0) 25%, rgb(1 28 66) 100%);"
        aria-hidden="true"
      >
      </div>
      <!-- Spotlight: two brighter copies of the grid masked to circles that follow the cursor,
           a wide soft halo and a tight core. Hover-capable devices only; invisible until the first pointer move. -->
      <div
        class="hero-spotlight hero-spotlight--halo absolute inset-0"
        style="background-image: radial-gradient(circle at center, rgba(250, 245, 239, 0.45) 1px, transparent 1.25px); background-size: 24px 24px;"
        aria-hidden="true"
      >
      </div>
      <div
        class="hero-spotlight hero-spotlight--core absolute inset-0"
        style="background-image: radial-gradient(circle at center, rgba(250, 245, 239, 0.9) 1.25px, transparent 1.5px); background-size: 24px 24px;"
        aria-hidden="true"
      >
      </div>
    </Fragment>
    <Fragment slot="subtitle">
      It's not a leadership problem — you just can't see your own numbers. You have jobs in your pipeline right now
      you'd turn down if you could see their actual margin.
    </Fragment>
    <Fragment slot="content">
      <p
        class="flex items-center gap-2 text-sm text-muted-on-dark/80 mt-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        <span class="text-accent" aria-hidden="true">&bull;</span>
        Free 2-minute assessment. No jargon. No obligation.
      </p>
      <!-- Chalk map: the operation diagrammed as a system, right of the copy. Desktop only. -->
      <HeroChalkMap />
    </Fragment>
  </Hero>

  <style is:global>
    .hero-spotlight {
      opacity: 0;
      transition: opacity 600ms ease;
      -webkit-mask-image: radial-gradient(
        circle var(--r) at var(--mx, -999px) var(--my, -999px),
        black 0%,
        rgb(0 0 0 / 0.5) 45%,
        transparent 100%
      );
      mask-image: radial-gradient(
        circle var(--r) at var(--mx, -999px) var(--my, -999px),
        black 0%,
        rgb(0 0 0 / 0.5) 45%,
        transparent 100%
      );
    }
    .hero-spotlight--halo {
      --r: 320px;
    }
    .hero-spotlight--core {
      --r: 110px;
    }
    @media (hover: hover) and (min-width: 768px) {
      #hero.is-lit .hero-spotlight {
        opacity: 1;
      }
    }
  </style>

  <script>
    const hero = document.getElementById('hero');
    if (hero && matchMedia('(hover: hover)').matches) {
      const instant = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let running = false;
      let lit = false;

      const tick = () => {
        // Ease toward the cursor so the light glides instead of snapping.
        const k = instant ? 1 : 0.18;
        x += (tx - x) * k;
        y += (ty - y) * k;
        hero.style.setProperty('--mx', `${x}px`);
        hero.style.setProperty('--my', `${y}px`);
        const settled = Math.abs(tx - x) < 0.5 && Math.abs(ty - y) < 0.5;
        if (lit || !settled) requestAnimationFrame(tick);
        else running = false;
      };

      hero.addEventListener('pointerenter', (e) => {
        const r = hero.getBoundingClientRect();
        x = tx = e.clientX - r.left;
        y = ty = e.clientY - r.top;
      });
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        tx = e.clientX - r.left;
        ty = e.clientY - r.top;
        lit = true;
        hero.classList.add('is-lit');
        if (!running) {
          running = true;
          requestAnimationFrame(tick);
        }
      });
      hero.addEventListener('pointerleave', () => {
        lit = false;
        hero.classList.remove('is-lit');
      });
    }
  </script>

  <!-- Problem Agitation ************* -->

  <ProblemAgitation />

  <!-- Stats — quantify the cost of the agitation moments above -->

  <Stats
    stats={[
      {
        amount: '88%',
        title: 'of spreadsheets have at least one error',
      },
      {
        amount: '58%',
        title: 'of business decisions are based on gut feel',
      },
      {
        amount: '15–25%',
        title: 'of revenue lost to data blind spots',
      },
    ]}
    isDark
  />

  <!-- How It Works — the path is simple -->

  <HowItWorks />

  <!-- Deliverable — signature moment: show what you actually get -->

  <Deliverable />

  <!-- Case Studies — proof the process works -->

  <CaseStudies />

  <!-- FAQ / Objection Handling -->

  <FAQ />

  <!-- Featured Testimonial ********** -->

  <FeaturedTestimonial />

  <!-- Risk Reversal — guarantee before the final ask -->

  <RiskReversal />

  <!-- Final CTA — last impression before footer -->

  <FinalCTA />
</Layout>
