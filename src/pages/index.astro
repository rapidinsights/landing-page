---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SolutionStack from '~/components/widgets/SolutionStack.astro';
import HowItWorks from '~/components/widgets/HowItWorks.astro';
import CaseStudies from '~/components/widgets/CaseStudies.astro';
import FAQ from '~/components/widgets/FAQ.astro';
import FeaturedTestimonial from '~/components/widgets/FeaturedTestimonial.astro';
import AboutGuide from '~/components/widgets/AboutGuide.astro';
import RiskReversal from '~/components/widgets/RiskReversal.astro';
import FinalCTA from '~/components/widgets/FinalCTA.astro';
import ProblemAgitation from '~/components/widgets/ProblemAgitation.astro';
import Stats from '~/components/widgets/Stats.astro';
const metadata = {
  title: 'Rapid Insights Consulting | Data & Analytics for Growing Businesses',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
      ]}
      actions={[
        {
          text: 'Find out what you can\'t see',
          href: '/scorecard',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero Widget ******************* -->

  <Hero
    id="hero"
    title="You spend more time reacting than leading."
    tagline=""
    actions={[{ variant: 'primary', text: 'Find out what you can\'t see', href: '/scorecard' }]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute top-[-20%] left-[-10%] w-[60%] h-[70%] rounded-full bg-accent/[0.06] blur-[100px]"></div>
        <div class="absolute bottom-[-10%] right-[-5%] w-[45%] h-[50%] rounded-full bg-primary/[0.08] blur-[80px]"></div>
      </div>
    </Fragment>
    <Fragment slot="subtitle">
      It's not a leadership problem — you just can't see your own numbers. You have jobs in your pipeline right now you'd turn down if you could see their actual margin.
    </Fragment>
    <Fragment slot="content">
      <p
        class="text-sm text-muted mt-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        Free 2-minute assessment. No jargon. No obligation.
      </p>
    </Fragment>
  </Hero>

  <!-- Problem Agitation ************* -->

  <ProblemAgitation />

  <!-- Stats — quantify the cost of the agitation moments above -->

  <Stats
    stats={[
      {
        amount: '88%',
        title: 'of spreadsheets have at least one error',
      },
      {
        amount: '58%',
        title: 'of business decisions are based on gut feel',
      },
      {
        amount: '15–25%',
        title: 'of revenue lost to data blind spots',
      },
    ]}
    isDark
  />

  <!-- Solution — here's what changes -->

  <SolutionStack />

  <!-- How It Works — the path is simple -->

  <HowItWorks />

  <!-- Case Studies — proof the process works -->

  <CaseStudies />

  <!-- FAQ / Objection Handling -->

  <FAQ />

  <!-- CTA — after showing problem, solution, AND process -->

  <CallToAction
    title="Stop guessing. Start seeing."
    subtitle="Take a free 2-minute assessment and find out where your blind spots are — before they cost you another quarter."
    actions={[{ variant: 'primary', text: 'Find out what you can\'t see', href: '/scorecard' }]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-section"></div>
    </Fragment>
  </CallToAction>

  <!-- Featured Testimonial ********** -->

  <FeaturedTestimonial />

  <!-- About the Guide — personal trust -->

  <AboutGuide />

  <!-- Risk Reversal — guarantee before the final ask -->

  <RiskReversal />

  <!-- Final CTA — last impression before footer -->

  <FinalCTA />
</Layout>
