---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BlogIndex from '~/components/widgets/BlogIndex.astro';
import { headerData, mapUrl } from '~/navigation';
import { categories, type BlogCategory } from '~/data/blog';

export function getStaticPaths() {
  return categories.map((cat) => ({ params: { category: cat.slug }, props: { cat } }));
}

const { cat } = Astro.props as { cat: BlogCategory };
---

<Layout metadata={{ title: cat.title }}>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ variant: 'primary', text: 'See what to fix first', href: mapUrl }]}
      isSticky
    />
  </Fragment>
  <BlogIndex active={cat.slug} />
</Layout>
