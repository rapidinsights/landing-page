---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import BlogIndex from '~/components/widgets/BlogIndex.astro';
import { headerData, mapUrl } from '~/navigation';
---

<Layout
  metadata={{
    title: 'Case studies',
    description:
      'Four small businesses, the problem each owner named, and the profit we got back by fixing how the work moved. Real numbers, with how long each took.',
  }}
>
  <Fragment slot="header">
    <Header
      links={headerData.links}
      actions={[{ variant: 'primary', text: 'See what to fix first', href: mapUrl }]}
      isSticky
    />
  </Fragment>
  <BlogIndex />
</Layout>
