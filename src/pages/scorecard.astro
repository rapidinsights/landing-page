---
import ScorecardLayout from '~/layouts/ScorecardLayout.astro';
import Scorecard from '~/components/widgets/Scorecard.svelte';

const metadata = {
  title: 'Business Visibility Scorecard — Rapid Insights',
  description: 'Find out what you can\'t see in your own business. Take a free 2-minute assessment and get your Visibility Report.',
};
---

<ScorecardLayout metadata={metadata}>
  <!-- Hidden Netlify Form for data capture (detected at deploy time) -->
  <form name="scorecard" netlify hidden>
    <input type="hidden" name="email" />
    <input type="hidden" name="score" />
    <input type="hidden" name="industry" />
    <input type="hidden" name="revenue" />
    <input type="hidden" name="weakest-areas" />
    <input type="hidden" name="tier" />
  </form>

  <!-- Svelte interactive scorecard -->
  <Scorecard client:load />
</ScorecardLayout>
