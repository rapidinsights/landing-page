---
import { Font } from 'astro:assets';
// The families are configured in `fonts` in astro.config.ts. The heading font
// sets the hero H1, the page's LCP element, so it alone is preloaded: the
// download starts with the HTML instead of after the stylesheet is parsed.
---

<Font cssVariable="--font-jakarta" preload />
<Font cssVariable="--font-jetbrains-mono" />
<Font cssVariable="--font-lora" />

<style is:inline>
  /* Colour tokens are bare space-separated CHANNEL LISTS ("1 28 66"). The
     @theme block in tailwind.css wraps each one as `rgb(var(--token))`, and
     the rgb() utilities in the same file do the same, so keep them unwrapped
     here or those rules produce an invalid colour.

     A channel list cannot itself carry an alpha, so a token that used to be
     `rgb(R G B / A%)` either flattens to its composite over the page
     background of the block it lives in, or drops the alpha here and states
     it at the call site (`text-muted-on-dark/80`). See DESIGN.md. */
  :root {
    color-scheme: light only;

    --aw-font-sans: var(--font-jakarta);
    --aw-font-serif: var(--font-jakarta);
    --aw-font-heading: var(--font-jakarta);
    --aw-font-mono: var(--font-jetbrains-mono);
    --aw-font-display: var(--font-lora);

    --aw-color-primary: 1 97 239;
    --aw-color-secondary: 1 84 207;
    --aw-color-accent: 109 40 217;

    --aw-color-text-heading: 0 0 0;
    --aw-color-text-default: 16 16 16;
    /* was rgb(16 16 16 / 66%), flattened over --aw-color-bg-page (255 255 255) */
    --aw-color-text-muted: 97 97 97;
    /* alpha moved to the call site: text-muted-on-dark/80 */
    --aw-color-text-muted-on-dark: 250 245 239;
    --aw-color-bg-page: 255 255 255;

    --aw-color-bg-page-dark: 3 6 32;
    --aw-color-bg-section: 239 246 255;

    /* Brand constants, not theme overrides — the Prussian field and the cream
       that sits on it are the same in every theme. */
    --aw-color-bg-prussian: 1 28 66;
    --aw-color-text-cream: 250 245 239;

    ::selection {
      background-color: lavender;
    }
  }

  .theme-prussian-orange {
    --aw-color-primary: 20 33 61;
    --aw-color-secondary: 45 106 159;
    --aw-color-accent: 252 163 17;

    --aw-color-text-heading: 26 26 46;
    --aw-color-text-default: 26 26 46;
    --aw-color-text-muted: 71 85 105;
    /* alpha moved to the call site: text-muted-on-dark/80 */
    --aw-color-text-muted-on-dark: 250 245 239;
    --aw-color-bg-page: 250 250 250;

    --aw-color-bg-page-dark: 20 33 61;
    --aw-color-bg-section: 237 240 247;

    /* Ink green, only for the drawn ticks. Desaturated so it sits beside the
       navy without competing with the orange, which owns every call to act. */
    --aw-color-check: 31 106 74;

    ::selection {
      background-color: rgb(252 163 17 / 30%);
    }
  }

  .theme-refined-gold {
    --aw-color-primary: 45 45 45;
    --aw-color-secondary: 90 90 90;
    --aw-color-accent: 212 168 67;

    --aw-color-text-heading: 26 26 26;
    --aw-color-text-default: 45 45 45;
    --aw-color-text-muted: 107 114 128;
    --aw-color-bg-page: 255 255 255;

    --aw-color-bg-page-dark: 26 26 26;
    /* was rgb(45 45 45 / 5%), flattened over --aw-color-bg-page (255 255 255) */
    --aw-color-bg-section: 245 245 245;

    ::selection {
      background-color: rgb(212 168 67 / 30%);
    }
  }

  .dark {
    --aw-font-sans: var(--font-jakarta);
    --aw-font-serif: var(--font-jakarta);
    --aw-font-heading: var(--font-jakarta);
    --aw-font-mono: var(--font-jetbrains-mono);
    --aw-font-display: var(--font-lora);

    --aw-color-primary: 1 97 239;
    --aw-color-secondary: 1 84 207;
    --aw-color-accent: 109 40 217;

    --aw-color-text-heading: 247 248 248;
    --aw-color-text-default: 229 236 246;
    /* was rgb(229 236 246 / 66%), flattened over --aw-color-bg-page (3 6 32) */
    --aw-color-text-muted: 152 158 173;
    --aw-color-bg-page: 3 6 32;

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
