---
import '~/assets/styles/fonts.css';
---

<style is:inline>
  :root {
    color-scheme: light only;

    --aw-font-sans: 'Plus Jakarta Sans Variable';
    --aw-font-serif: 'Plus Jakarta Sans Variable';
    --aw-font-heading: 'Plus Jakarta Sans Variable';
    --aw-font-mono: 'JetBrains Mono Variable';
    --aw-font-display: 'Lora Variable';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-text-muted-on-dark: rgb(250 245 239 / 80%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(3 6 32);
    --aw-color-bg-section: rgb(239 246 255);

    /* Brand constants, not theme overrides — the Prussian field and the cream
       that sits on it are the same in every theme. */
    --aw-color-bg-prussian: rgb(1 28 66);
    --aw-color-text-cream: rgb(250 245 239);

    ::selection {
      background-color: lavender;
    }
  }

  .theme-prussian-orange {
    --aw-color-primary: rgb(20 33 61);
    --aw-color-secondary: rgb(45 106 159);
    --aw-color-accent: rgb(252 163 17);

    --aw-color-text-heading: rgb(26 26 46);
    --aw-color-text-default: rgb(26 26 46);
    --aw-color-text-muted: rgb(71 85 105);
    --aw-color-text-muted-on-dark: rgb(250 245 239 / 80%);
    --aw-color-bg-page: rgb(250 250 250);

    --aw-color-bg-page-dark: rgb(20 33 61);
    --aw-color-bg-section: rgb(237 240 247);

    ::selection {
      background-color: rgb(252 163 17 / 30%);
    }
  }

  .theme-refined-gold {
    --aw-color-primary: rgb(45 45 45);
    --aw-color-secondary: rgb(90 90 90);
    --aw-color-accent: rgb(212 168 67);

    --aw-color-text-heading: rgb(26 26 26);
    --aw-color-text-default: rgb(45 45 45);
    --aw-color-text-muted: rgb(107 114 128);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(26 26 26);
    --aw-color-bg-section: rgb(45 45 45 / 5%);

    ::selection {
      background-color: rgb(212 168 67 / 30%);
    }
  }

  .dark {
    --aw-font-sans: 'Plus Jakarta Sans Variable';
    --aw-font-serif: 'Plus Jakarta Sans Variable';
    --aw-font-heading: 'Plus Jakarta Sans Variable';
    --aw-font-mono: 'JetBrains Mono Variable';
    --aw-font-display: 'Lora Variable';

    --aw-color-primary: rgb(1 97 239);
    --aw-color-secondary: rgb(1 84 207);
    --aw-color-accent: rgb(109 40 217);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(3 6 32);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
