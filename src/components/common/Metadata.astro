---
import merge from 'lodash.merge';
import { SEO } from 'astro-seo';

import type { Props as SEOProps } from 'astro-seo';

import { SITE, METADATA, I18N } from 'astrowind:config';
import type { MetaData, MetaDataOpenGraph, MetaDataTwitter } from '~/types';
import { getCanonical } from '~/utils/permalinks';

import { adaptOpenGraphImages } from '~/utils/images';

export interface Props extends MetaData {
  dontUseTitleTemplate?: boolean;
}

const {
  title,
  ignoreTitleTemplate = false,
  canonical = String(getCanonical(String(Astro.url.pathname))),
  robots = {},
  description,
  openGraph = {},
  twitter = {},
} = Astro.props;

const resolvedTitle = title || METADATA?.title?.default || '';
const resolvedDescription = description || METADATA?.description;

const mergedOg: MetaDataOpenGraph = merge(
  {
    url: canonical,
    siteName: SITE?.name,
    images: [],
    locale: I18N?.language || 'en',
    type: 'website',
  },
  METADATA?.openGraph,
  { url: canonical, ...openGraph }
);

const adaptedOg = await adaptOpenGraphImages(mergedOg, Astro.site);
const firstImage = adaptedOg.images?.[0];

const mergedTwitter: MetaDataTwitter = merge(
  { cardType: openGraph?.images?.length ? 'summary_large_image' : 'summary' },
  METADATA?.twitter,
  twitter
);

const seoProps: SEOProps = {
  title: resolvedTitle,
  titleTemplate: ignoreTitleTemplate ? '%s' : METADATA?.title?.template || '%s',
  canonical,
  noindex:
    typeof robots?.index !== 'undefined'
      ? !robots.index
      : typeof METADATA?.robots?.index !== 'undefined'
        ? !METADATA.robots.index
        : true,
  nofollow:
    typeof robots?.follow !== 'undefined'
      ? !robots.follow
      : typeof METADATA?.robots?.follow !== 'undefined'
        ? !METADATA.robots.follow
        : true,
  description: resolvedDescription,
  openGraph: firstImage?.url
    ? {
        basic: {
          title: resolvedTitle,
          type: adaptedOg.type || 'website',
          image: firstImage.url,
          url: adaptedOg.url,
        },
        optional: {
          description: resolvedDescription,
          locale: adaptedOg.locale,
          siteName: adaptedOg.siteName,
        },
        image: {
          width: firstImage.width,
          height: firstImage.height,
        },
      }
    : undefined,
  twitter: {
    card: mergedTwitter.cardType as NonNullable<SEOProps['twitter']>['card'],
    site: mergedTwitter.site,
    creator: mergedTwitter.handle,
  },
  surpressWarnings: true,
};
---

<SEO {...seoProps} />
