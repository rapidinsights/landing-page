---
/**
 * Featured Testimonial — single full-width blockquote with real client quote.
 * Editorial layout: oversized quote mark, Lora italic text, headshot + attribution.
 * Hardcoded content (like ProblemAgitation) — no props needed for a single testimonial.
 */
import Image from '~/components/common/Image.astro';
import johnHeadshot from '~/assets/images/johnlaroy.webp';
import arLogo from '~/assets/images/AR-2.jpg';
---

<section id="testimonial" class="relative not-prose scroll-mt-[72px]">
  <div class="absolute inset-0 bg-section"></div>

  <div class="relative mx-auto max-w-3xl px-4 md:px-6 py-16 md:py-24 lg:py-32 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">

    <!-- Decorative quote mark -->
    <span class="block font-display text-[8rem] leading-none text-accent opacity-20 -mb-12 md:-mb-16" aria-hidden="true">
      &ldquo;
    </span>

    <!-- Quote -->
    <blockquote>
      <p class="font-display italic text-2xl md:text-3xl leading-snug text-default">
        Our managers are back to leading with clear and reliable data.
        Working with Rapid Insights has been a win for our team. They delivered
        exactly what we needed through smart data analysis, performance tracking,
        dashboard development, and production capacity planning. Nothing feels
        impossible when Rapid Insights is involved&nbsp;&mdash;&nbsp;we highly recommend their work.
      </p>
    </blockquote>

    <!-- Attribution -->
    <div class="mt-8 md:mt-10 flex items-center gap-4">
      <div class="h-14 w-14 flex-shrink-0 overflow-hidden rounded-full border-2 border-accent/30">
        <Image
          src={johnHeadshot}
          alt="John L., CEO of Apparel Redefined"
          width={56}
          height={56}
          class="h-full w-full object-cover"
          loading="lazy"
        />
      </div>
      <div>
        <p class="font-heading font-semibold text-base text-default">John L.</p>
        <p class="text-sm text-muted">CEO, Apparel Redefined</p>
      </div>
      <div class="ml-2 h-8 flex-shrink-0 opacity-60">
        <Image
          src={arLogo}
          alt="Apparel Redefined logo"
          width={32}
          height={32}
          class="h-8 w-auto object-contain"
          loading="lazy"
        />
      </div>
    </div>

  </div>
</section>
