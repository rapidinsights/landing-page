---
/**
 * Blog index — everything published, newest first. The newest entry gets the
 * stage with its photo, opening paragraph and result; the rest sit in two
 * columns below. Filter chips link to one page per category and only show once
 * there is more than one category to choose from. Tags are the outcomes each
 * entry delivered; the tag row links to one page per tag.
 */
import { Image } from 'astro:assets';
import { categories, tags, tagSlug } from '~/data/blog';
import { finishedMonth, type Outcome } from '~/data/cases';

interface Props {
  // Category slug; omitted for the unfiltered list.
  active?: string;
  tag?: Outcome;
}

const { active, tag } = Astro.props;

const entries = categories
  .filter((cat) => !active || cat.slug === active)
  .flatMap((cat) => cat.entries.map((c) => ({ ...c, entryLabel: cat.entryLabel })))
  .filter((c) => !tag || c.outcomes.includes(tag))
  .sort((a, b) => b.finished.localeCompare(a.finished));

const [lead, ...rest] = entries;

const chips = [{ href: '/blog', title: 'All', current: !active && !tag }].concat(
  categories.map((cat) => ({ href: `/blog/${cat.slug}`, title: cat.title, current: cat.slug === active }))
);

const tagLinks = [{ href: '/blog', title: 'Any result', current: !tag }].concat(
  tags.map((t) => ({ href: `/blog/tag/${tagSlug(t)}`, title: t, current: t === tag }))
);
---

<section class="mx-auto max-w-7xl px-4 md:px-6 pt-16 md:pt-24 pb-16 md:pb-24 lg:pb-32">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between pb-10 border-b border-default/10">
    <div>
      <p class="font-mono text-sm uppercase tracking-label text-secondary">Blog</p>
      <h1 class="mt-3 max-w-3xl font-heading text-4xl md:text-5xl font-bold tracking-heading text-default">
        What I find inside businesses, and what changed
      </h1>
    </div>
    {
      categories.length > 1 && (
        <nav aria-label="Filter posts" class="flex flex-wrap gap-2">
          {chips.map((chip) => (
            <a
              href={chip.href}
              aria-current={chip.current ? 'page' : undefined}
              class:list={[
                'whitespace-nowrap rounded-full border px-4 py-2 font-mono text-sm uppercase tracking-label',
                chip.current
                  ? 'border-primary bg-primary text-white'
                  : 'border-default/20 bg-white text-default hover:border-primary',
              ]}
            >
              {chip.title}
            </a>
          ))}
        </nav>
      )
    }
  </div>

  <nav aria-label="Filter by result" class="flex flex-wrap items-baseline gap-x-2 gap-y-2 pt-6 pb-2">
    <p class="mr-2 font-mono text-sm uppercase tracking-label text-muted">Filter by result</p>
    {
      tagLinks.map((t) => (
        <a
          href={t.href}
          aria-current={t.current ? 'page' : undefined}
          class:list={[
            'rounded-full border px-3 py-1.5 text-sm',
            t.current
              ? 'border-primary bg-primary text-white'
              : 'border-default/15 bg-white text-default hover:border-primary',
          ]}
        >
          {t.title}
        </a>
      ))
    }
  </nav>

  {
    lead && (
      <a
        href={`/cases/${lead.slug}`}
        class="group grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-8 lg:gap-12 items-center py-12 border-b border-default/10"
      >
        {lead.image ? (
          <Image
            src={lead.image}
            alt={lead.imageAlt ?? ''}
            widths={[640, 960, 1320]}
            sizes="(min-width: 1024px) 700px, 100vw"
            class="aspect-[4/3] w-full rounded-xl object-cover object-[50%_28%]"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div
            class="aspect-[4/3] rounded-xl bg-section flex items-center justify-center font-mono text-sm uppercase tracking-label text-muted"
            aria-hidden="true"
          >
            [Image]
          </div>
        )}
        <div>
          <p class="font-mono text-sm uppercase tracking-label text-secondary">
            {lead.entryLabel} · {lead.name} · {lead.business}
          </p>
          <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold leading-tight text-default decoration-accent decoration-2 underline-offset-[6px] group-hover:underline">
            {lead.problem}
          </h2>
          <p class="mt-4 font-display text-lg leading-relaxed text-default">{lead.story[0].paragraphs[0]}</p>
          <p class="mt-4 text-sm text-muted">{lead.outcomes.join(', ')}</p>
          <div class="mt-7 pt-5 border-t border-default/10 flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <p class="flex items-baseline gap-1.5 font-heading text-4xl font-bold tracking-heading tabular-nums leading-none text-primary">
              {lead.value}
              {lead.valueUnit && <span class="text-lg font-semibold tracking-normal">{lead.valueUnit}</span>}
            </p>
            <div class="font-mono text-sm uppercase tracking-label text-muted">
              <p>{lead.valueLabel}</p>
              <p class="mt-1">
                <span class="font-bold text-default">{lead.took}</span> · {finishedMonth(lead, 'short')}
              </p>
            </div>
          </div>
        </div>
      </a>
    )
  }

  {
    rest.length > 0 && (
      <ul class="m-0 p-0 list-none grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-14 pt-12">
        {rest.map((c) => (
          <li>
            <a href={`/cases/${c.slug}`} class="group block">
              {c.image ? (
                <Image
                  src={c.image}
                  alt={c.imageAlt ?? ''}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="aspect-video w-full rounded-xl object-cover object-[50%_28%]"
                />
              ) : (
                <div
                  class="aspect-video rounded-xl bg-section flex items-center justify-center font-mono text-sm uppercase tracking-label text-muted"
                  aria-hidden="true"
                >
                  [Image]
                </div>
              )}
              <p class="mt-5 font-mono text-sm uppercase tracking-label text-secondary">
                {c.entryLabel} · {c.name} · {c.business}
              </p>
              <h2 class="mt-2 font-display text-2xl font-semibold leading-snug text-default decoration-accent decoration-2 underline-offset-[6px] group-hover:underline">
                {c.problem}
              </h2>
              <p class="mt-3 text-sm text-muted">{c.outcomes.join(', ')}</p>
              <div class="mt-5 flex items-baseline justify-between gap-4">
                <p class="flex items-baseline gap-1 font-heading text-2xl font-bold tracking-heading tabular-nums text-primary">
                  {c.value}
                  {c.valueUnit && <span class="text-base font-semibold tracking-normal">{c.valueUnit}</span>}
                </p>
                <p class="font-mono text-sm uppercase tracking-label text-muted">{finishedMonth(c, 'short')}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>
