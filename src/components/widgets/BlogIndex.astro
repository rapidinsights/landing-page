---
/**
 * Case studies index — every case, newest first. The newest entry gets the
 * stage with its photo, opening paragraph and result; the rest sit in two
 * columns below. Tags are the outcomes each entry delivered; the tag row links
 * to one page per tag.
 */
import { Image } from 'astro:assets';
import { categories, tags, tagSlug } from '~/data/blog';
import { finishedMonth, type Outcome } from '~/data/cases';

interface Props {
  tag?: Outcome;
}

const { tag } = Astro.props;

const entries = categories
  .flatMap((cat) => cat.entries.map((c) => ({ ...c, entryLabel: cat.entryLabel })))
  .filter((c) => !tag || c.outcomes.includes(tag))
  .sort((a, b) => b.finished.localeCompare(a.finished));

const [lead, ...rest] = entries;

const tagLinks = [{ href: '/case-studies', title: 'Any result', current: !tag }].concat(
  tags.map((t) => ({ href: `/case-studies/tag/${tagSlug(t)}`, title: t, current: t === tag }))
);

// A loose loop that overshoots its own start, so it reads as circled by hand.
const penCircle = `<svg class="pen-circle" viewBox="0 0 200 80" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" vector-effect="non-scaling-stroke" d="M30 12 C80 2 170 4 192 26 C206 44 180 70 110 74 C50 78 6 66 8 42 C10 20 50 8 124 10" /></svg>`;
---

<section class="mx-auto max-w-7xl px-4 md:px-6 pt-16 md:pt-24 pb-16 md:pb-24 lg:pb-32">
  <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between pb-10 border-b border-default/10">
    <div>
      <p class="font-mono text-sm uppercase tracking-label text-secondary">Case studies</p>
      <h1 class="mt-3 max-w-3xl font-heading text-4xl md:text-5xl font-bold tracking-heading text-default">
        What I find inside businesses, and what changed
      </h1>
    </div>
  </div>

  <nav aria-label="Filter by result" class="flex flex-wrap items-baseline gap-x-2 gap-y-2 pt-6 pb-2">
    <p class="mr-2 font-mono text-sm uppercase tracking-label text-muted">Filter by result</p>
    {
      tagLinks.map((t) => (
        <a
          href={t.href}
          aria-current={t.current ? 'page' : undefined}
          class:list={[
            'rounded-full border px-3 py-1.5 text-sm',
            t.current
              ? 'border-primary bg-primary text-white'
              : 'border-default/15 bg-white text-default hover:border-primary',
          ]}
        >
          {t.title}
        </a>
      ))
    }
  </nav>

  {
    lead && (
      <a
        href={`/cases/${lead.slug}`}
        class="group grid grid-cols-1 lg:grid-cols-[1.35fr_1fr] gap-8 lg:gap-12 items-center py-12 border-b border-default/10"
      >
        {lead.image ? (
          <Image
            src={lead.image}
            alt={lead.imageAlt ?? ''}
            widths={[640, 960, 1320]}
            sizes="(min-width: 1024px) 700px, 100vw"
            class="aspect-4/3 w-full rounded-xl object-cover object-[50%_28%]"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div
            class="aspect-4/3 rounded-xl bg-section flex items-center justify-center font-mono text-sm uppercase tracking-label text-muted"
            aria-hidden="true"
          >
            [Image]
          </div>
        )}
        <div>
          <p class="font-mono text-sm uppercase tracking-label text-secondary">
            {lead.entryLabel} · {lead.name} · {lead.business}
          </p>
          <h2 class="mt-3 font-display text-3xl md:text-4xl font-semibold leading-tight md:leading-10 text-default">
            <span class="pen-underline">{lead.problem}</span>
          </h2>
          <p class="mt-4 font-display text-lg leading-relaxed text-default">{lead.story[0].paragraphs[0]}</p>
          <p class="mt-4 text-sm text-muted">{lead.outcomes.join(', ')}</p>
          <div class="mt-7 pt-5 border-t border-default/10 flex flex-wrap items-baseline gap-x-4 gap-y-2">
            <p class="relative flex items-baseline gap-1.5 font-heading text-4xl font-bold tracking-heading tabular-nums leading-none text-primary">
              {lead.value}
              {lead.valueUnit && <span class="text-lg font-semibold tracking-normal">{lead.valueUnit}</span>}
              <Fragment set:html={penCircle} />
            </p>
            <div class="font-mono text-sm uppercase tracking-label text-muted">
              <p>{lead.valueLabel}</p>
              <p class="mt-1">
                <span class="font-bold text-default">{lead.took}</span> · {finishedMonth(lead, 'short')}
              </p>
            </div>
          </div>
        </div>
      </a>
    )
  }

  {
    rest.length > 0 && (
      <ul class="m-0 p-0 list-none grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-14 pt-12">
        {rest.map((c) => (
          <li>
            <a href={`/cases/${c.slug}`} class="group block">
              {c.image ? (
                <Image
                  src={c.image}
                  alt={c.imageAlt ?? ''}
                  widths={[400, 640, 960]}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  class="aspect-video w-full rounded-xl object-cover object-[50%_28%]"
                />
              ) : (
                <div
                  class="aspect-video rounded-xl bg-section flex items-center justify-center font-mono text-sm uppercase tracking-label text-muted"
                  aria-hidden="true"
                >
                  [Image]
                </div>
              )}
              <p class="mt-5 font-mono text-sm uppercase tracking-label text-secondary">
                {c.entryLabel} · {c.name} · {c.business}
              </p>
              <h2 class="mt-2 font-display text-2xl font-semibold leading-snug text-default">
                <span class="pen-underline">{c.problem}</span>
              </h2>
              <p class="mt-3 text-sm text-muted">{c.outcomes.join(', ')}</p>
              <div class="mt-5 flex items-baseline justify-between gap-4">
                <p class="relative flex items-baseline gap-1 font-heading text-2xl font-bold tracking-heading tabular-nums text-primary">
                  {c.value}
                  {c.valueUnit && <span class="text-base font-semibold tracking-normal">{c.valueUnit}</span>}
                  <Fragment set:html={penCircle} />
                </p>
                <p class="font-mono text-sm uppercase tracking-label text-muted">{finishedMonth(c, 'short')}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  /* Hovering a post draws the underline under its title left to right, like a
     pen. The line is a background on the inline span, so on a title that wraps
     it runs along the first line, then the next, in reading order. */
  .pen-underline {
    background-image: linear-gradient(rgb(var(--aw-color-accent)), rgb(var(--aw-color-accent)));
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0% 2px;
    padding-bottom: 4px;
    transition: background-size 250ms ease-in;
  }
  :global(.group):hover .pen-underline,
  :global(.group):focus-visible .pen-underline {
    background-size: 100% 2px;
    transition: background-size 700ms cubic-bezier(0.45, 0.05, 0.35, 1);
  }
  /* Then the pen circles the result: the loop draws itself once the underline is
     mostly done, and is wiped quickly on leave. It stretches to fit each figure. */
  :global(.pen-circle) {
    position: absolute;
    top: -14px;
    left: -20px;
    width: calc(100% + 40px);
    height: calc(100% + 28px);
    overflow: visible;
    pointer-events: none;
  }
  :global(.pen-circle path) {
    fill: none;
    stroke: rgb(var(--aw-color-accent));
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1 2;
    stroke-dashoffset: 1.01;
    transition: stroke-dashoffset 200ms ease-in;
  }
  :global(.group):hover :global(.pen-circle path),
  :global(.group):focus-visible :global(.pen-circle path) {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 800ms cubic-bezier(0.45, 0.05, 0.35, 1) 450ms;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.pen-circle path),
    :global(.group):hover :global(.pen-circle path),
    :global(.group):focus-visible :global(.pen-circle path) {
      transition: none;
    }
    .pen-underline,
    :global(.group):hover .pen-underline,
    :global(.group):focus-visible .pen-underline {
      transition: none;
    }
  }
</style>
