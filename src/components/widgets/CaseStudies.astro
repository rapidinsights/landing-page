---
/**
 * Case Studies — three jobs told from the owner's side, so a reader spots a
 * business like theirs and sees the problem has been fixed before. Each card
 * carries the value equation: who the business is (likelihood), the problem,
 * the value captured in dollars (dream outcome) with where it came from, and
 * how long it took (time delay). The section total in the heading is the sum of the three values.
 * Each links to its own page at /cases/[slug]. Data lives in ~/data/cases.
 * Motion: as a card scrolls in it rises. On hover the card turns into a preview
 * of the story, fading out mid-paragraph like a paywalled article.
 * Bracketed values are placeholders until the real figures and images land.
 */

import { Image } from 'astro:assets';
import { cases, readMinutes } from '~/data/cases';
---

<section id="case-studies" class="relative not-prose bg-page scroll-mt-[72px]">
  <div class="mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-24 lg:py-32">
    <div
      class="max-w-3xl mb-12 md:mb-16 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <p class="font-mono text-sm uppercase tracking-label text-secondary mb-3">Case studies</p>
      <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-heading text-default">
        [$Total] saved for three businesses like yours
      </h2>
    </div>

    <ul class="cs-grid grid grid-cols-1 md:grid-cols-3 gap-6 m-0 p-0 list-none">
      {
        cases.map((c, i) => (
          <li
            class="cs-card intersect intersect-once intersect-quarter md:grid md:grid-rows-subgrid md:row-span-6"
            style={`--d: ${i * 250}ms`}
          >
            <article class="cs-rise relative overflow-hidden flex flex-col gap-5 md:grid md:grid-rows-subgrid md:row-span-6 md:gap-y-5 rounded-2xl bg-white p-5 pb-7">
              {c.image ? (
                <Image
                  src={c.image}
                  alt={c.imageAlt ?? ''}
                  widths={[400, 600, 828]}
                  sizes="(min-width: 768px) 33vw, 100vw"
                  class="h-[200px] w-full rounded-lg object-cover object-[50%_28%]"
                />
              ) : (
                <div
                  class="h-[200px] rounded-lg bg-section flex items-center justify-center font-mono text-sm uppercase tracking-label text-muted"
                  aria-hidden="true"
                >
                  [Image]
                </div>
              )}

              <div class="px-2 flex flex-col gap-1">
                <p class="text-lg font-bold text-default">{c.name}</p>
                <p class="font-mono text-sm uppercase tracking-label text-muted">{c.business}</p>
              </div>

              <h3 class="px-2 text-lg md:text-xl font-semibold leading-relaxed text-default">{c.problem}</h3>

              <div class="px-2 pt-5 border-t border-default/10 flex flex-col gap-1.5">
                <p class="font-mono text-sm uppercase tracking-label text-muted">Value captured</p>
                <p class="font-heading text-3xl md:text-4xl font-bold tracking-heading tabular-nums leading-tight text-primary">
                  {c.value}
                </p>
                <p class="text-sm leading-relaxed text-muted">{c.basis}</p>
              </div>

              <dl class="px-2 m-0">
                <dt class="font-mono text-sm uppercase tracking-label text-muted">How long</dt>
                <dd class="m-0 mt-1 text-base leading-relaxed text-default">{c.took}</dd>
              </dl>

              <a
                href={`/cases/${c.slug}`}
                class="cs-link mx-2 self-start font-mono text-sm uppercase tracking-label text-primary"
              >
                Read the case study
                <span class="sr-only">: {c.label}</span>
                <span class="absolute inset-0 rounded-2xl" aria-hidden="true" />
              </a>

              <div class="cs-preview absolute inset-0 bg-white px-7 pt-7 pb-20 flex flex-col gap-3" aria-hidden="true">
                <p class="font-mono text-sm uppercase tracking-label text-muted">
                  {c.name} · {readMinutes(c)} min read
                </p>
                <p class="font-display text-xl font-semibold leading-snug text-default">{c.problem}</p>
                <div class="cs-fade relative flex-1 overflow-hidden">
                  {c.story[0].paragraphs.map((p) => (
                    <p class="font-display text-base leading-relaxed text-default mb-3">{p}</p>
                  ))}
                </div>
                <span class="absolute left-7 bottom-7 rounded-full bg-primary px-4 py-2.5 font-mono text-sm uppercase tracking-label text-white">
                  Keep reading
                </span>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- Inline, not bundled: this CSS sits below the fold, and in the shared stylesheet it delays
     the hero's first paint. Bundled, it pushed / LCP past the 2.0s gate. Class names carry a
     cs- prefix because inline styles are not scoped. -->
<style is:inline>
  .cs-grid {
    --ease: cubic-bezier(0.33, 1, 0.68, 1);
  }

  /* Reveal: cards rise one at a time as they scroll in; desktop staggers them via --d. */
  @media (prefers-reduced-motion: no-preference) {
    .cs-rise {
      opacity: 0;
      transform: translateY(16px);
    }
    .cs-card:not([no-intersect]) .cs-rise {
      animation: cs-rise 900ms var(--ease) forwards;
      animation-delay: var(--d);
    }
  }
  @media (max-width: 767px) {
    .cs-card {
      --d: 0ms !important;
    }
  }
  @keyframes cs-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Peek: on hover the card becomes a preview of its story. Pointer events pass
     through to the card's stretched link underneath. The 400ms delay (NN/g) keeps
     a cursor passing over the row from flashing previews; leaving hides at once. */
  .cs-preview {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition:
      opacity 400ms var(--ease),
      transform 500ms var(--ease);
  }
  .cs-fade::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 160px;
    background: linear-gradient(rgb(255 255 255 / 0), rgb(255 255 255));
  }
  @media (hover: hover) {
    .cs-card:hover .cs-preview {
      opacity: 1;
      transform: none;
      transition-delay: 400ms;
    }
  }
  .cs-link {
    padding-bottom: 6px;
    background-image:
      linear-gradient(rgb(var(--aw-color-accent)), rgb(var(--aw-color-accent))),
      linear-gradient(rgb(var(--aw-color-accent) / 0.3), rgb(var(--aw-color-accent) / 0.3));
    background-position:
      left bottom,
      left bottom;
    background-size:
      0% 2px,
      100% 2px;
    background-repeat: no-repeat;
    transition: background-size 550ms var(--ease);
  }
  .cs-link:focus-visible {
    background-size:
      100% 2px,
      100% 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-preview {
      transform: none;
    }
    .cs-link {
      transition: none;
    }
  }
</style>
