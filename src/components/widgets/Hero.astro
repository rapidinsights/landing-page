---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<section class="relative md:mt-[-76px] not-prose bg-[rgb(1_28_66)]" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 md:pt-[76px]">
    <div class="py-16 md:py-0 md:min-h-[calc(85vh-76px)] lg:min-h-[calc(88vh-76px)] flex flex-col">
      <!-- `relative` so the chalk map (absolute, in the content slot) spans the headline block, not the foot slot. -->
      <div class="relative flex-1 flex items-center w-full">
        <div class="grid grid-cols-12 gap-6 w-full">
          <div class="col-span-12 md:col-span-9 lg:col-span-8 xl:col-span-7">
            {
              tagline && (
                <p
                  class="font-mono text-sm uppercase tracking-label text-accent mb-6 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                  set:html={tagline}
                />
              )
            }
            {
              title && (
                <h1
                  class="text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.03] md:leading-none tracking-heading mb-6 md:mb-8 font-heading text-[#FAF5EF] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                  set:html={title}
                />
              )
            }
            {
              subtitle && (
                <p
                  class="text-lg md:text-xl text-[rgb(250_245_239/65%)] leading-relaxed md:leading-7 max-w-[56ch] mb-8 md:mb-10 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
                  set:html={subtitle}
                />
              )
            }
            {
              actions && (
                <div class="flex flex-col sm:flex-row sm:justify-start gap-4 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                  {Array.isArray(actions) ? (
                    actions.map((action) => (
                      <div class="flex w-full sm:w-auto">
                        <Button {...(action || {})} class="w-full sm:w-auto" />
                      </div>
                    ))
                  ) : (
                    <Fragment set:html={actions} />
                  )}
                </div>
              )
            }
            {content && <Fragment set:html={content} />}
          </div>
        </div>
      </div>
      <!-- Foot slot: content that must sit inside the first viewport, below the headline block (the client-logo rail). -->
      <slot name="foot" />
    </div>
    {
      image && (
        <div class="relative max-w-5xl mx-auto pb-12 intersect-once intersect-no-queue intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
          {typeof image === 'string' ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="mx-auto rounded-md w-full"
              widths={[400, 768, 1024, 2040]}
              sizes="(max-width: 767px) 400px, (max-width: 1023px) 768px, (max-width: 2039px) 1024px, 2040px"
              loading="eager"
              width={1024}
              height={576}
              {...image}
            />
          )}
        </div>
      )
    }
  </div>
</section>
