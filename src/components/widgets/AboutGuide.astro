---
/**
 * About the Founder / Guide — builds personal trust for B2B consulting.
 * StoryBrand: customer = hero, consultant = guide.
 * Positioned after FeaturedTestimonial, before RiskReversal.
 * Hardcoded content — no props needed.
 */
import Image from '~/components/common/Image.astro';
import guideShot from '~/assets/images/guide_shot.jpg';
---

<section id="about" class="relative not-prose scroll-mt-[72px]">
  <div class="relative mx-auto max-w-4xl px-4 md:px-6 py-16 md:py-24 lg:py-32">

    <div class="flex flex-col md:flex-row items-center md:items-start gap-8 md:gap-12 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">

      <!-- Photo -->
      <div class="flex-shrink-0">
        <div class="w-40 h-48 md:w-48 md:h-56 rounded-2xl overflow-hidden shadow-sm">
          <Image
            src={guideShot}
            alt="Derek Wayne, founder of Rapid Insights"
            width={384}
            height={448}
            class="w-full h-full object-cover object-[center_55%]"
          />
        </div>
      </div>

      <!-- Bio -->
      <div class="flex-1 text-center md:text-left">
        <p class="text-sm uppercase tracking-label font-mono text-muted mb-2">Your guide</p>
        <h2 class="font-heading text-2xl md:text-3xl font-bold tracking-tight text-default">
          Derek Wayne
        </h2>

        <div class="mt-4 space-y-3 text-base md:text-lg leading-relaxed text-muted">
          <p>
            I built Rapid Insights after watching dozens of SMBs make expensive decisions
            on bad data &mdash; or no data at all. The pattern was always the same: smart
            owners flying blind because their numbers were trapped in spreadsheets nobody trusted.
          </p>
          <p>
            I've spent over a decade in data &amp; analytics, from Fortune 500 operations to
            10-person shops. I know what enterprise-grade visibility looks like, and I know how
            to deliver it without the enterprise price tag or timeline.
          </p>
        </div>

        <!-- Authority markers -->
        <div class="mt-6 flex flex-wrap justify-center md:justify-start gap-x-6 gap-y-2 text-sm text-muted">
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" />
            </svg>
            10+ years in data &amp; analytics
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
            </svg>
            Fortune 500 to 10-person teams
          </span>
          <span class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.745 3.745 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
            </svg>
            Built for SMBs, not enterprises
          </span>
        </div>
      </div>

    </div>
  </div>
</section>
