---
/**
 * Client Logos — a four-mark rail at the foot of the hero.
 * Establishes that real companies have hired me before the visitor reads
 * a single argument. Rendered via the Hero `foot` slot so it stays above
 * the fold. Tonal, not full-colour: every mark flattens to one cream tone
 * so nothing competes with the orange CTA above it.
 */
import { Image } from 'astro:assets';
import abm from '~/assets/images/logos/abm.svg';
import apparelRedefined from '~/assets/images/logos/apparel-redefined.png';
import b2btail from '~/assets/images/logos/b2btail.png';
import coolChoir from '~/assets/images/logos/cool-choir.webp';

// Heights are set per mark so the four very different shapes read at the same optical weight.
const logos = [
  { src: abm, alt: 'ABM', height: 30, class: 'h-[30px]' },
  { src: apparelRedefined, alt: 'Apparel Redefined', height: 30, class: 'h-[30px]' },
  { src: b2btail, alt: 'B2BTail', height: 26, class: 'h-[26px]' },
  { src: coolChoir, alt: 'Cool Choir', height: 44, class: 'h-[44px]' },
];
---

<div
  class="mt-6 border-t border-cream/15 pt-6 pb-9 md:pt-7 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
>
  <p class="font-mono text-sm uppercase tracking-label text-cream/60">Who we&rsquo;ve helped</p>
  <ul class="mt-5 grid grid-cols-2 gap-x-8 gap-y-6 md:grid-cols-4 items-center">
    {
      logos.map((logo) => (
        <li>
          <Image
            src={logo.src}
            alt={logo.alt}
            height={logo.height}
            loading="eager"
            densities={[1, 2]}
            class:list={['w-auto brightness-0 invert opacity-70', logo.class]}
          />
        </li>
      ))
    }
  </ul>
</div>
