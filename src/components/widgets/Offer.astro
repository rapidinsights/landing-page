---
/**
 * Offer — the free map: what it is, what you leave with, why it's free, with
 * three FAQ items beneath. Fifth beat.
 * Wireframe draft — the real copy and layout land in RAP-375. Headings and FAQ
 * questions are the brief's; the body lines are placeholders.
 */
import Button from '~/components/ui/Button.astro';
import { mapUrl } from '~/navigation';

const blocks = [
  {
    heading: 'What it is',
    body: 'A guided walkthrough that maps how work moves through your business and finds where it gets stuck. You answer structured questions; the diagram draws itself. You never draw.',
  },
  {
    heading: 'What you leave with',
    body: 'Your operation drawn as a flow, the stuck points marked and scored, a ranked list of what to fix first, a fix pattern for each, and an hours-to-dollars estimate with the arithmetic shown.',
  },
  {
    heading: 'Why it is free',
    body: 'It is my method, packaged. The map is the first thing I would build with you anyway. If it shows enough to work with, I offer to review it. Nothing ships unreviewed.',
  },
];

const faqs = [
  {
    q: 'Who is this for?',
    a: 'Placeholder: the positive fit statement. Leaders of operating units of roughly 20 to 300 people, several systems, physical work happening somewhere.',
  },
  {
    q: 'What does the audit cost?',
    a: 'Placeholder: free while the offer is being tested; priced once three audits have become builds.',
  },
  {
    q: 'What happens after?',
    a: 'Placeholder: the map lives at a private link; the audit is a review of the map you built, drafted, then reviewed by me.',
  },
];
---

<section id="offer" class="relative not-prose">
  <div class="relative mx-auto max-w-6xl px-4 md:px-6 py-16 md:py-24 lg:py-32">
    <p class="font-mono text-[10px] uppercase tracking-label text-muted mb-6">Draft · beat 5 · the offer · RAP-375</p>

    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-16 items-start">
      <!-- Copy: 3/5 -->
      <div
        class="md:col-span-3 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight text-default max-w-[18ch]">
          Map how work moves through your business.
        </h2>
        <p class="mt-4 text-lg text-muted max-w-[52ch]">Free. 8 minutes. No email needed to use it.</p>

        <dl class="mt-10 space-y-8">
          {
            blocks.map((b) => (
              <div>
                <dt class="font-mono text-xs uppercase tracking-label text-secondary">{b.heading}</dt>
                <dd class="mt-2 text-base leading-relaxed text-default max-w-[56ch]">{b.body}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-5">
          <Button variant="primary" text="See what to fix first" href={mapUrl} />
          <p class="text-sm text-muted">Built and reviewed by Derek Wayne, Rapid Insights.</p>
        </div>
      </div>

      <!-- Output preview: 2/5. The tool's rendered map goes here. -->
      <div
        class="md:col-span-2 rounded-md border border-dashed border-muted/40 bg-section p-6 min-h-[22rem] flex flex-col intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
      >
        <p class="font-mono text-[10px] uppercase tracking-label text-muted">
          Placeholder: your map, as the tool renders it
        </p>
        <div class="flex-1 mt-6 grid grid-cols-3 gap-3 content-start" aria-hidden="true">
          <div class="h-10 border border-muted/40"></div>
          <div class="h-10 border border-muted/40"></div>
          <div class="h-10 border border-accent/70"></div>
          <div class="h-10 border border-muted/40 col-start-2"></div>
          <div class="h-10 border border-accent/70"></div>
          <div class="h-10 border border-muted/40 col-start-1"></div>
          <div class="h-10 border border-muted/40"></div>
        </div>
        <div class="mt-6 border-t border-muted/30 pt-4">
          <p class="font-mono text-[11px] uppercase tracking-label text-muted">Leverage points</p>
          <p class="mt-1 font-heading text-2xl font-bold text-default">≈ 14 hrs / week</p>
          <p class="text-xs text-muted">recovered capacity, arithmetic shown</p>
        </div>
      </div>
    </div>

    <!-- FAQ: three items, native details -->
    <div
      class="mt-16 md:mt-20 max-w-3xl intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      {
        faqs.map((f) => (
          <details class="group border-t border-muted/30 py-5">
            <summary class="cursor-pointer list-none flex items-baseline justify-between gap-6 font-heading text-lg font-semibold text-default">
              {f.q}
              <span class="font-mono text-muted group-open:rotate-45 transition-transform" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="mt-3 text-base leading-relaxed text-muted max-w-[60ch]">{f.a}</p>
          </details>
        ))
      }
      <div class="border-t border-muted/30"></div>
    </div>
  </div>
</section>
