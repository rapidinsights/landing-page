---
/**
 * Final CTA — the page's ending, on the same prussian field as the hero so the
 * page opens and shuts on the same ground. Fifth beat, and the last thing anyone
 * reads. Structure follows docs/final-cta-research.md: a bridge heading, a look
 * at the tool in use, the one button, and under it the costs and the last doubts
 * about starting, answered in two short lines. It mirrors the hero's shape, copy
 * on the left and the moving picture on the right, so the page closes the way it
 * opened. On phones the video sits between the copy and the button, so the
 * reader sees the tool before being asked to use it.
 * The direct line is a booking link under the button, beside a headshot, so it
 * reads as meeting a person rather than a second equal choice. The calendar
 * takes about three seconds to load, so it loads hidden inside a dialog once the
 * link scrolls into view, and a click only has to show it. Without the script,
 * the link opens the booking page in a new tab.
 * The recording of the tool and its poster load as the section nears the screen;
 * with reduced motion it stays on the poster, the last frame, which shows the answer. The
 * line about where answers go describes the map; the tool has to keep it true.
 */
import { Image } from 'astro:assets';
import Button from '~/components/ui/Button.astro';
import { bookingUrl, mapUrl } from '~/navigation';
import headshot from '~/assets/images/derek-wayne-headshot.webp';

const finalCtaBookingUrl = `${bookingUrl}?hide_event_type_details=1&hide_gdpr_banner=1&utm_source=website&utm_medium=home&utm_content=final-cta`;
---

<section id="final-cta" class="relative not-prose bg-prussian text-cream">
  <div
    class="relative mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-24 lg:py-32 grid grid-cols-1 lg:grid-cols-[5fr_6fr] lg:grid-rows-[auto_auto] gap-y-10 lg:gap-x-16 lg:gap-y-10 items-start intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div class="lg:self-end">
      <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-heading text-cream max-w-[20ch]">
        Stop fighting the same fires. Get back to growing profitably.
      </h2>
      <p class="mt-5 text-lg md:text-xl leading-relaxed text-cream/80 max-w-[40ch]">
        Most consulting starts with two months of discovery. This starts with eight minutes.
      </p>
    </div>

    <!-- The Free Process Map in use, recorded by scripts/record-demo.mjs in rapid-insights-app.
         One clip per layout; only the one on screen loads, and only as the section nears. -->
    <div class="lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center w-full">
      <video
        class="demo hidden md:block w-full h-auto rounded-xl ring-1 ring-cream/20 bg-white"
        width="1600"
        height="1000"
        data-poster="/videos/free-process-map-desktop.webp"
        preload="none"
        muted
        loop
        playsinline
        aria-label="The Free Process Map: an owner sends some work back from checking to making, and the map moves its look-here-first ring to making."
      >
        <source src="/videos/free-process-map-desktop.mp4" type="video/mp4" />
        <source src="/videos/free-process-map-desktop.webm" type="video/webm" />
      </video>
      <video
        class="demo md:hidden mx-auto block h-auto max-h-[70vh] w-auto max-w-full rounded-xl ring-1 ring-cream/20 bg-white"
        width="780"
        height="1688"
        data-poster="/videos/free-process-map-phone.webp"
        preload="none"
        muted
        loop
        playsinline
        aria-label="The Free Process Map: an owner sends some work back from checking to making, and the map moves its look-here-first ring to making."
      >
        <source src="/videos/free-process-map-phone.mp4" type="video/mp4" />
        <source src="/videos/free-process-map-phone.webm" type="video/webm" />
      </video>
    </div>

    <div class="lg:col-start-1 lg:row-start-2">
      <Button variant="primary" text="See what to fix first" href={mapUrl} />
      <p class="mt-3 text-sm leading-relaxed text-cream/80 max-w-[46ch]">
        Free. Under 8 minutes. No email needed.<br />
        Everything saved in your own browser.
      </p>

      <div class="mt-8 max-w-[46ch] grid grid-cols-[4rem_1fr] items-center gap-4 border-t border-cream/15 pt-6">
        <Image
          src={headshot}
          alt="Derek Wayne"
          width={64}
          height={64}
          densities={[2, 3]}
          class="h-16 w-16 rounded-full"
        />
        <p class="m-0 text-base leading-relaxed text-cream/85">
          Rather talk first? I'll hear what keeps breaking and tell you straight if I can help.
          <a
            href={finalCtaBookingUrl}
            target="_blank"
            rel="noopener"
            data-calendly
            class="font-semibold text-cream underline decoration-accent decoration-2 underline-offset-4 hover:decoration-cream"
            >Book a 30-minute call</a
          >
        </p>
      </div>
    </div>
  </div>
</section>

<dialog id="booking-dialog" aria-label="Book a 30-minute call" data-lenis-prevent>
  <button type="button" aria-label="Close" class="booking-close">&times;</button>
</dialog>

<style>
  #booking-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    /* Under ~650px wide Calendly fills the frame edge to edge. Wider, it centers a
       smaller card inside, and the close button above the right edge floats off
       beside it. The height cap keeps room above for that button. */
    width: min(560px, calc(100vw - 2rem));
    height: min(760px, calc(100dvh - 7rem));
    max-width: none;
    max-height: none;
    padding: 0;
    border: 0;
    background: white;
    overflow: visible;
  }
  #booking-dialog::backdrop {
    background: rgb(var(--aw-color-bg-prussian) / 0.7);
  }
  #booking-dialog :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .booking-close {
    position: absolute;
    top: -2.75rem;
    right: 0;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 2rem;
    line-height: 1;
    color: rgb(var(--aw-color-text-cream));
    background: transparent;
    border: 0;
    cursor: pointer;
  }
</style>

<script>
  // The poster is set here, not in the HTML: in the HTML it loads with the page and pushes LCP past 2s.
  const motion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const near = new IntersectionObserver(
    (entries) => {
      for (const { target, isIntersecting } of entries) {
        const video = target as HTMLVideoElement;
        // The clip for the other layout is display:none and never loads.
        if (!video.offsetParent) continue;
        if (!isIntersecting) {
          video.pause();
          continue;
        }
        if (!video.poster && video.dataset.poster) video.poster = video.dataset.poster;
        if (motion) video.play().catch(() => {});
      }
    },
    { rootMargin: '200px' }
  );
  document.querySelectorAll<HTMLVideoElement>('#final-cta video.demo').forEach((v) => near.observe(v));

  const dialog = document.querySelector<HTMLDialogElement>('#booking-dialog');
  const link = document.querySelector<HTMLAnchorElement>('a[data-calendly]');

  if (dialog && link) {
    const loadCalendar = () => {
      if (dialog.querySelector('iframe')) return;
      const frame = document.createElement('iframe');
      frame.title = 'Pick a time for a 30-minute call';
      frame.src = `${link.href}&embed_domain=${encodeURIComponent(location.host)}&embed_type=PopupText`;
      dialog.append(frame);
    };

    link.addEventListener('click', (e) => {
      e.preventDefault();
      loadCalendar();
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelector('.booking-close')?.addEventListener('click', () => dialog.close());
  }
</script>
