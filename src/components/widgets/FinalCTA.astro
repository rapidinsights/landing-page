---
/**
 * Final CTA — the page's ending, on the same prussian field as the hero so the
 * page opens and shuts on the same ground. Fifth beat, and the last thing anyone
 * reads. Structure follows docs/final-cta-research.md: a bridge heading, what
 * happens when you click, the one button with its cost line, a quiet line for
 * the reader who would rather talk, and nothing after it. The last doubts about
 * starting the free tool sit beside the action, each answered at once, because
 * a doubt raised without an answer hurts more than silence.
 * The direct contact line is a reserved slot only, left out of the render: the
 * contact route is undecided and is its own issue.
 * The steps and the answer about where answers go describe the map prototype;
 * the shipped tool has to keep them true.
 */
import Button from '~/components/ui/Button.astro';
import { mapUrl } from '~/navigation';

const steps = [
  'Answer plain questions about how an order moves through your business. Nothing to look up.',
  'Watch a map of your operation build as you go, with the stuck spots marked.',
  'Leave with the one fix worth doing first, and about what it costs you each year.',
];

const doubts = [
  {
    question: 'Why is it free?',
    answer:
      "It does the first hour of my job. If it finds something big, you'll want to talk, and I'll already know where to look. If not, you spent eight minutes, not a sales meeting.",
  },
  {
    question: 'What happens to my answers?',
    answer: 'They stay in your browser. Nothing reaches me unless you send it.',
  },
  {
    question: 'Will someone chase me?',
    answer: "No. I don't have your email, so I can't. If you want to talk, you reach out.",
  },
  {
    question: 'Will it work for my kind of business?',
    answer: "It's built for businesses that make, move, or install things. If work moves through steps, it fits.",
  },
  {
    question: 'What if it finds nothing?',
    answer: "Then it says so. Some businesses run tight, and that's worth knowing too.",
  },
];
---

<section id="final-cta" class="relative not-prose bg-prussian text-cream">
  <div
    class="relative mx-auto max-w-7xl px-4 md:px-6 py-16 md:py-24 lg:py-32 grid grid-cols-1 lg:grid-cols-[7fr_6fr] gap-14 lg:gap-24 items-start intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <div>
      <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-heading text-cream max-w-[20ch]">
        Stop fighting the same fires. Get back to growing profitably.
      </h2>
      <p class="mt-5 text-lg md:text-xl leading-relaxed text-cream/80 max-w-[40ch]">
        Most consulting starts with two months of discovery. This starts with eight minutes.
      </p>

      <ol class="mt-10 m-0 p-0 list-none flex flex-col gap-4">
        {
          steps.map((step, i) => (
            <li class="grid grid-cols-[2.25rem_1fr] text-lg leading-relaxed text-cream">
              <span class="pt-1 font-mono text-xs text-accent" aria-hidden="true">
                0{i + 1}
              </span>
              {step}
            </li>
          ))
        }
      </ol>

      <div class="mt-10">
        <Button variant="primary" text="See what to fix first" href={mapUrl} />
        <p class="mt-3 text-sm text-cream/80">Free. Under 8 minutes. No email needed.</p>
      </div>

      <!-- Reserved: the quiet direct ask, for the reader who would rather talk than
           use the tool. Not rendered; the contact route is its own issue. -->
    </div>

    <dl class="m-0 flex flex-col gap-7 border-t border-cream/15 pt-10 lg:border-t-0 lg:pt-0 lg:border-l lg:pl-12">
      {
        doubts.map((d) => (
          <div>
            <dt class="text-lg font-bold leading-snug text-cream">{d.question}</dt>
            <dd class="m-0 mt-1.5 text-base leading-relaxed text-cream/75">{d.answer}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
