---
/**
 * FinalCTA — dramatic bottom-of-page call to action.
 * Last impression before the footer. Hardcoded copy, no props.
 * Positioned after FeaturedTestimonial in index.astro.
 */
import Button from '~/components/ui/Button.astro';
---

<section id="final-cta" class="relative not-prose scroll-mt-[72px]">
  <div class="absolute inset-0 bg-[rgb(3_6_32)]"></div>

  <div class="relative mx-auto max-w-3xl px-4 md:px-6 py-20 md:py-28 lg:py-36 text-center">

    <!-- Transformation headline -->
    <h2
      class="font-heading text-4xl md:text-5xl lg:text-[56px] leading-tighter font-bold text-[#FAF5EF]
        intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      Stop Drowning in Spreadsheets.<br />Start Running Your Business.
    </h2>

    <!-- Paint the "after" picture -->
    <p
      class="mt-6 md:mt-8 font-display italic text-lg md:text-xl leading-relaxed text-[rgb(250_245_239_/_70%)]
        intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      Imagine opening your phone and seeing exactly how your business is doing &mdash;
      every metric, every trend, updated automatically.
    </p>

    <!-- Stakes / urgency -->
    <p
      class="mt-4 text-base md:text-lg leading-relaxed text-[rgb(250_245_239_/_55%)]
        intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      Every week you wait is another week of bad data, wasted hours, and missed insights.
    </p>

    <!-- Oversized CTA button -->
    <div
      class="mt-10 md:mt-12
        intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <Button
        variant="primary"
        href="/scorecard"
        class="text-lg md:text-xl py-4 px-8 md:px-10"
        text="Find out what you can't see"
      />
    </div>

    <!-- Microcopy -->
    <p
      class="mt-4 text-sm text-[rgb(250_245_239_/_35%)]
        intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      Free 2-minute assessment. No jargon. No obligation.
    </p>

  </div>
</section>
