---
/**
 * Final CTA — the page's ending. Repeats the one action at the point of highest
 * intent, on the same prussian field as the hero so the page opens and shuts on
 * the same ground. Eighth beat, and the last thing anyone reads.
 * Wireframe draft — the real copy lands in RAP-386. The direct contact line is a
 * reserved slot only: the contact route is undecided and is its own issue.
 */
import Button from '~/components/ui/Button.astro';
import { mapUrl } from '~/navigation';
---

<section id="final-cta" class="relative not-prose bg-prussian text-cream">
  <div
    class="relative mx-auto max-w-4xl px-4 md:px-6 py-16 md:py-24 lg:py-32 text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <p class="font-mono text-[10px] uppercase tracking-label text-cream/60 mb-6">
      Draft · beat 8 · final CTA · RAP-386
    </p>

    <h2 class="font-heading text-3xl md:text-5xl font-bold tracking-tight text-cream max-w-[20ch] mx-auto">
      Find out what to fix first.
    </h2>

    <p class="mt-5 text-lg text-cream/65 max-w-[46ch] mx-auto leading-relaxed">Free. 8 minutes. No email needed.</p>

    <div class="mt-10 flex justify-center">
      <Button variant="primary" text="See what to fix first" href={mapUrl} />
    </div>

    <!-- Reserved: the quiet direct ask, for the reader who would rather talk than
         use the tool. Not wired here; the contact route is its own issue. -->
    <p class="mt-12 font-mono text-[11px] uppercase tracking-label text-cream/60">
      Placeholder: direct contact line — not wired (structure only)
    </p>
  </div>
</section>
