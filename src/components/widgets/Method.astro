---
/**
 * Method — how I work in three steps: Look → Find → Fix.
 * Sits right after the hero. On desktop the three steps scroll past as ordinary
 * page content, one viewport each, while a single large numeral pinned on the
 * left ticks over as each step reaches the middle of the screen. The text moves
 * at scroll speed and can always be scrolled back to. Step one is the free map.
 * Step three lists the ways I help and carries the section's only CTA.
 * On phones the numeral is a short bar pinned under the site header instead.
 */
import Button from '~/components/ui/Button.astro';
import { mapUrl } from '~/navigation';

const steps = [
  { n: '01', word: 'Look', free: true },
  { n: '02', word: 'Find', free: false },
  { n: '03', word: 'Fix', free: false },
];

const ways = [
  {
    name: 'Automation',
    icon: '<path d="M4 10a6 6 0 0 1 10.5-4M16 10a6 6 0 0 1-10.5 4"/><path d="M14 3v3h-3M6 17v-3h3"/>',
  },
  {
    name: 'AI',
    icon: '<path d="M10 3l1.6 4.4L16 9l-4.4 1.6L10 15l-1.6-4.4L4 9l4.4-1.6z"/><path d="M16 14l.7 1.8 1.8.7-1.8.7L16 19l-.7-1.8-1.8-.7 1.8-.7z"/>',
  },
  {
    name: 'Software',
    icon: '<rect x="2.5" y="4" width="15" height="12" rx="1.5"/><path d="M7 9l-2 1.5L7 12M13 9l2 1.5-2 1.5"/>',
  },
  {
    name: 'Data',
    icon: '<ellipse cx="10" cy="5" rx="6" ry="2.5"/><path d="M4 5v10c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5V5M4 10c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5"/>',
  },
  { name: 'Strategy', icon: '<circle cx="10" cy="10" r="7.5"/><path d="M13 7l-1.7 4.3L7 13l1.7-4.3z"/>' },
];
---

<section id="method" class="relative not-prose bg-page" data-step="01">
  <div class="mx-auto max-w-6xl px-4 md:px-6 py-16 md:py-0 grid grid-cols-1 md:grid-cols-12 md:gap-x-6">
    <h2 class="sr-only">How I work</h2>

    <!-- Pinned numeral: one row of the ticker is visible; the row for the active step slides into view.
         A short bar under the site header on phones, a full-height column on desktop. -->
    <div
      class="sticky top-[76px] z-10 bg-page pt-4 md:pt-0 flex flex-col md:justify-center md:col-span-5 md:h-[calc(100vh-76px)]"
      aria-hidden="true"
    >
      <p class="font-mono text-xs uppercase tracking-label text-secondary mb-3 md:mb-5">How I work</p>
      <div class="ticker h-20 md:h-28 overflow-clip border-t border-b border-default/15">
        <div class="ticker-rows">
          {
            steps.map((s) => (
              <div class="flex items-baseline gap-4 md:gap-5 h-20 md:h-28 leading-none">
                <b class="text-6xl md:text-8xl font-extrabold tracking-[-0.03em] tabular-nums text-secondary">{s.n}</b>
                <span class="text-2xl md:text-3xl font-semibold">{s.word}</span>
                {s.free && (
                  <span class="ml-auto font-mono text-xs uppercase tracking-label text-primary border-b-2 border-accent pb-0.5">
                    free
                  </span>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <ol class="m-0 p-0 list-none md:col-start-7 md:col-span-6">
      {
        steps.map((s, i) => (
          <li
            data-step={s.n}
            class="step flex flex-col gap-5 py-10 md:py-0 md:min-h-[calc(100vh-76px)] md:justify-center border-t first:border-0 border-default/15 md:border-0"
          >
            {i === 0 && (
              <>
                <h3 class="font-heading text-6xl md:text-8xl font-extrabold leading-[0.95] tracking-[-0.03em]">
                  I look at how your work moves.
                </h3>
                <p class="text-lg md:text-xl leading-relaxed max-w-[46ch]">
                  I draw the path a job takes through your shop. Where it starts, where it waits, where it stops. Not
                  the org chart. The real path.
                </p>
                <p class="font-mono text-xs uppercase tracking-label text-muted">
                  You get: a map of your business. It is free, and you keep it.
                </p>
              </>
            )}
            {i === 1 && (
              <>
                <h3 class="font-heading text-6xl md:text-8xl font-extrabold leading-[0.95] tracking-[-0.03em]">
                  I find the spot that slows it all.
                </h3>
                <p class="text-lg md:text-xl leading-relaxed max-w-[46ch]">
                  Most of the wait comes from one or two places on the map. I find them, and I show you what they cost.
                </p>
                <p class="font-mono text-xs uppercase tracking-label text-muted">
                  You get: a short list, with a number on each line.
                </p>
              </>
            )}
            {i === 2 && (
              <>
                <h3 class="font-heading text-6xl md:text-8xl font-extrabold leading-[0.95] tracking-[-0.03em]">
                  I build the fix.
                </h3>
                <p class="text-lg md:text-xl leading-relaxed max-w-[46ch]">
                  Small, specific, yours. Usually one or two of these:
                </p>
                <ul class="flex flex-wrap gap-x-8 gap-y-3 m-0 p-0 list-none">
                  {ways.map((w) => (
                    <li class="flex items-center gap-2.5 font-semibold text-lg">
                      <svg
                        viewBox="0 0 20 20"
                        class="w-5 h-5 text-secondary shrink-0"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        set:html={w.icon}
                      />
                      {w.name}
                    </li>
                  ))}
                </ul>
                <div class="flex">
                  <Button variant="primary" text="See what to fix first" href={mapUrl} />
                </div>
              </>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ticker {
    --row: 5rem;
  }
  @media (min-width: 768px) {
    .ticker {
      --row: 7rem;
    }
  }
  .ticker-rows {
    transition: transform 500ms cubic-bezier(0.33, 1, 0.68, 1);
  }
  #method[data-step='02'] .ticker-rows {
    transform: translateY(calc(var(--row) * -1));
  }
  #method[data-step='03'] .ticker-rows {
    transform: translateY(calc(var(--row) * -2));
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-rows {
      transition: none;
    }
  }
</style>

<script>
  // Tick the pinned numeral to whichever step is crossing the middle of the
  // viewport. Observer root is a one-pixel line at the centre, so one step
  // intersects at a time.
  const section = document.getElementById('method')!;
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) section.dataset.step = (e.target as HTMLElement).dataset.step;
      }
    },
    { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
  );
  section.querySelectorAll<HTMLElement>('.step').forEach((s) => io.observe(s));
</script>
