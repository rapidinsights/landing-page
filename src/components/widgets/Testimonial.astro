---
/**
 * Testimonial — one client card right after the Method steps, so the reader
 * sees a named result before the examples. Photo, quote, and a link to the
 * full case study page.
 * The whole card is that link: the anchor's ::after is stretched over the card,
 * so there is still exactly one tab stop and one accessible name. On hover the
 * card tips toward the reader on a diagonal and lifts its shadow off the band.
 */
import Image from '~/components/common/Image.astro';
import headshot from '~/assets/images/johnlaroy.webp';
---

<section id="testimonial" class="relative not-prose bg-prussian">
  <div class="mx-auto max-w-6xl px-4 md:px-6 py-16 md:py-24 lg:py-28 flex justify-center">
    <!-- The reveal sits on this wrapper, not the card: animate-fade fills forwards
         and would otherwise hold the card's transform and block the hover tilt. -->
    <div
      class="t-stage w-full max-w-5xl intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
    >
      <figure
        class="t-card relative bg-white rounded-2xl p-6 md:p-14 md:pr-16 grid grid-cols-1 md:grid-cols-[240px_minmax(0,1fr)] gap-6 md:gap-14 items-center"
      >
        <div class="flex md:block items-center gap-4">
          <Image
            src={headshot}
            alt="John Laroy"
            width={240}
            height={300}
            class="w-[72px] h-[90px] md:w-[240px] md:h-[300px] rounded-lg md:rounded-xl object-cover grayscale"
          />
          <figcaption class="md:hidden font-mono text-sm uppercase tracking-label text-muted leading-relaxed">
            John Laroy<br />CEO, Apparel Redefined
          </figcaption>
        </div>
        <div class="flex flex-col gap-5 md:gap-6">
          <p class="font-mono text-sm uppercase tracking-label text-secondary">Who this has worked for</p>
          <blockquote class="font-display text-default">
            <p class="text-2xl md:text-3xl leading-snug md:leading-9">
              &ldquo;Our managers are back to leading with clear and reliable data.
            </p>
            <p class="mt-4 text-lg md:text-xl leading-relaxed md:leading-7 text-default/75">
              Working with Rapid Insights has been a win for our team. They delivered exactly what we needed through
              smart data analysis, performance tracking, dashboard development, and production capacity planning.
              Nothing feels impossible when Rapid Insights is involved. We highly recommend their work.&rdquo;
            </p>
          </blockquote>
          <figcaption class="hidden md:block font-mono text-sm uppercase tracking-label text-muted">
            John Laroy &middot; CEO, Apparel Redefined
          </figcaption>
          <a
            href="/cases/apparel-redefined-late-orders"
            data-astro-prefetch
            class="t-link self-start border-t border-default/10 pt-5 font-mono text-sm uppercase tracking-label text-primary underline decoration-accent decoration-2 underline-offset-4 hover:decoration-primary"
          >
            Read the full case study
          </a>
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .t-stage {
    perspective: 1200px;
  }

  /* At rest the card sits flat on the band with just enough shadow to separate
     it. On hover the near corner is top-left, so the shadow pools down-right. */
  .t-card {
    box-shadow: 0 3px 12px -6px rgb(0 0 0 / 0.55);
    transition:
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) {
    .t-card:hover,
    .t-card:focus-within {
      transform: rotateX(-3.5deg) rotateY(5deg) translateY(-10px);
      box-shadow:
        26px 46px 80px -26px rgb(0 0 0 / 0.75),
        9px 16px 30px -14px rgb(0 0 0 / 0.55);
    }
  }

  /* The link's own box is the tab stop and the accessible name; this stretches
     its hit area over the whole card, so hovering anywhere lights both. */
  .t-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .t-card {
      transition: none;
    }
    .t-card:hover,
    .t-card:focus-within {
      transform: none;
    }
  }
</style>
