---
/**
 * How It Works — vertical timeline with connecting line.
 * Reduces complexity anxiety by showing the path is simple.
 * Steps aligned to actual conversion funnel: scorecard → game plan → launch.
 * Hardcoded content — no props needed.
 */
---

<section id="how-it-works" class="relative not-prose scroll-mt-[72px]">
  <div class="absolute inset-0 bg-section"></div>

  <div class="relative mx-auto max-w-5xl px-4 md:px-6 py-16 md:py-24 lg:py-32">

    <!-- Section header -->
    <div class="mb-10 md:mb-14 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
      <h2 class="font-heading text-3xl md:text-4xl font-bold tracking-tight text-default">
        How it works
      </h2>
      <p class="mt-3 text-lg text-muted">
        From first call to live dashboard in weeks.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative max-w-2xl">

      <!-- Vertical connecting line -->
      <div class="absolute left-5 md:left-[1.6rem] top-2 bottom-2 w-px bg-primary/15" aria-hidden="true"></div>

      <!-- Step 01 -->
      <div class="relative flex gap-6 md:gap-8 pb-12 md:pb-16 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div class="flex-shrink-0 relative z-10">
          <span class="flex w-10 h-10 md:w-[3.2rem] md:h-[3.2rem] rounded-full bg-primary text-white items-center justify-center text-sm font-mono font-semibold shadow-sm shadow-primary/20">01</span>
        </div>
        <div class="pt-1.5 md:pt-2.5">
          <h3 class="font-heading text-lg md:text-xl font-bold text-default mb-3">
            Take the 2-minute assessment
          </h3>
          <p class="text-base leading-relaxed text-muted">
            Answer a few questions about how your business runs today. You'll see exactly where your
            blind spots are &mdash; free, instant results.
          </p>
        </div>
      </div>

      <!-- Step 02 -->
      <div class="relative flex gap-6 md:gap-8 pb-12 md:pb-16 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div class="flex-shrink-0 relative z-10">
          <span class="flex w-10 h-10 md:w-[3.2rem] md:h-[3.2rem] rounded-full bg-primary text-white items-center justify-center text-sm font-mono font-semibold shadow-sm shadow-primary/20">02</span>
        </div>
        <div class="pt-1.5 md:pt-2.5">
          <h3 class="font-heading text-lg md:text-xl font-bold text-default mb-3">
            Get your custom game plan
          </h3>
          <p class="text-base leading-relaxed text-muted">
            We'll walk you through what's costing you time and money &mdash; and show you exactly
            what the fix looks like for your business. No jargon. No obligation.
          </p>
        </div>
      </div>

      <!-- Step 03 -->
      <div class="relative flex gap-6 md:gap-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <div class="flex-shrink-0 relative z-10">
          <span class="flex w-10 h-10 md:w-[3.2rem] md:h-[3.2rem] rounded-full bg-accent text-primary items-center justify-center text-sm font-mono font-semibold shadow-sm shadow-accent/20">03</span>
        </div>
        <div class="pt-1.5 md:pt-2.5">
          <h3 class="font-heading text-lg md:text-xl font-bold text-default mb-3">
            See your numbers in weeks
          </h3>
          <p class="text-base leading-relaxed text-muted">
            We connect your existing tools, build your dashboards, and train your team.
            Most clients go live in 4&ndash;6 weeks.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>
