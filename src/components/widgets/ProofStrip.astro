---
/**
 * Proof Strip — three quantified results, no context, each linking to its case page.
 * Second beat: the reader sees the outcome before the argument, and before any claim.
 * Wireframe draft — the real body lands in RAP-378. Numbers are the settled ones;
 * the links 404 until the case pages (RAP-376) exist.
 */
const results = [
  { number: '8 hrs → 5 min', label: 'SOP creation, facility services', href: '/cases/abm-sop-generator' },
  { number: '200 → 20 hrs/month', label: 'Budget reporting, facility services', href: '/cases/abm-budget-reporting' },
  {
    number: null,
    label: 'Receiving bottleneck removed, apparel manufacturing',
    href: '/cases/apparel-redefined-receiving',
  },
];
---

<section id="proof" class="relative not-prose bg-section">
  <div
    class="relative mx-auto max-w-6xl px-4 md:px-6 py-12 md:py-16 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade"
  >
    <h2 class="sr-only">Results</h2>
    <p class="font-mono text-[10px] uppercase tracking-label text-muted mb-6">Draft · beat 2 · proof strip · RAP-378</p>
    <ul class="grid grid-cols-1 md:grid-cols-3 gap-10">
      {
        results.map((r) => (
          <li>
            <a href={r.href} class="block group">
              <span class="block font-heading text-4xl md:text-5xl font-bold tracking-tight text-default group-hover:text-primary transition-colors">
                {r.number ?? <span class="text-muted font-semibold">Case study</span>}
              </span>
              <span class="block mt-3 font-mono text-sm uppercase tracking-label text-muted">{r.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
